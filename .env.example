# TypeSafe AI key for Jev, called directly (not through Vercel AI Gateway --
# switched after the Gateway account needed a $10 minimum credit top-up).
# Get one at https://console.typesafe.ai/keys (no waitlist).
TYPESAFE_API_KEY=

# Model id to request for Jev classification
JEV_MODEL_ID=jev-latest

# Anthropic key for the Layer 3 escalation writeups (omit if using a gateway route for Claude too)
ANTHROPIC_API_KEY=

# Port for the local demo server
PORT=8787
